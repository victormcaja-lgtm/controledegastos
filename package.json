{
  "name": "grana",
  "private": true,
  "version": "1.0.0",
  "description": "Grana — controle financeiro pessoal (monorepo: API Fastify + Web React)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build:shared": "npm run build -w @grana/shared",
    "build:api": "npm run build -w @grana/api",
    "build:web": "npm run build -w @grana/web",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "dev:api": "npm run dev -w @grana/api",
    "dev:web": "npm run dev -w @grana/web",
    "dev": "npm run build:shared && concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @grana/api",
    "db:deploy": "npm run db:deploy -w @grana/api",
    "db:seed": "npm run db:seed -w @grana/api",
    "db:studio": "npm run db:studio -w @grana/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
