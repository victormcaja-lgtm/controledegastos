# URL da API. Em produção, aponte para o domínio público da Railway.
# Toda variável exposta ao browser precisa do prefixo VITE_.
VITE_API_URL=http://localhost:3333

# Saldo futuro (Home com saldo contínuo, Diário, Posso comprar?, Cartões, Resultado).
# Ligado por padrão; "false" volta para as telas antigas sem reverter código.
VITE_FEATURE_SALDO_FUTURO=true
