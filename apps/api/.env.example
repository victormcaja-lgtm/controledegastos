# ───────────────────────── Ambiente ─────────────────────────
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# ───────────────────────── Banco ────────────────────────────
# Local (container Docker mapeado na porta 5433 — veja docker-compose.yml):
#           postgresql://postgres:postgres@localhost:5433/grana_dev?schema=public
# Railway:  cole a variável ${{ Postgres.DATABASE_URL }} (referência, não o valor)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/grana_dev?schema=public

# ───────────────────────── Segurança ────────────────────────
# Gere cada segredo com:  openssl rand -base64 48
JWT_ACCESS_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-no-minimo-32-caracteres
JWT_REFRESH_SECRET=troque-por-outro-segredo-longo-diferente-do-de-cima-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Origens autorizadas do front (separadas por vírgula, sem barra no final)
CORS_ORIGINS=http://localhost:5173

# Domínio do cookie de refresh. Em produção, deixe vazio se a API e o front
# estiverem em domínios diferentes (o cookie será SameSite=None; Secure).
COOKIE_DOMAIN=

# Rate limit global (janela de 1 minuto)
RATE_LIMIT_MAX=200
# Rate limit específico do /auth/login (janela de 15 minutos, por IP)
LOGIN_RATE_LIMIT_MAX=8

# ───────────────────── Administrador inicial ────────────────
# Usado apenas pelo `npm run db:seed`. Nunca versione os valores reais.
ADMIN_EMAIL=admin@grana.app
ADMIN_PASSWORD=TrocaEssaSenha123
ADMIN_NAME=Administrador

# Cria dados de exemplo (categorias, contas, lançamentos) no seed
SEED_DEMO_DATA=true
